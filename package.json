{
  "name": "nice-electrolyte-clinical-decision-support",
  "version": "0.1.0",
  "private": true,
  "description": "Source-governed clinical pathway prototype for adult electrolyte abnormalities using deterministic TypeScript evaluation and explicit clinical review.",
  "type": "module",
  "scripts": {
    "dev": "cross-env NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "cross-env NEXT_TELEMETRY_DISABLED=1 next start",
    "cf:build": "cross-env NEXT_TELEMETRY_DISABLED=1 opennextjs-cloudflare build",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "preview": "npm run cf:build && opennextjs-cloudflare preview",
    "deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "upload": "npm run cf:build && opennextjs-cloudflare upload",
    "bundle:analyze": "next experimental-analyze --output",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "sources:check": "node --experimental-strip-types scripts/check-clinical-source-registry.ts",
    "test": "vitest run",
    "pretest:a11y": "npm run build",
    "test:a11y": "node scripts/run-e2e.mjs tests/e2e/accessibility-responsive-audit.spec.ts --reporter=line",
    "pretest:performance": "npm run build",
    "test:performance": "node scripts/run-e2e.mjs tests/e2e/performance.spec.ts --reporter=line",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "npm run build",
    "test:e2e": "node scripts/run-e2e.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moiz101-ch/nice-electrolyte-clinical-decision-support.git"
  },
  "keywords": [
    "clinical-decision-support",
    "nice",
    "electrolytes",
    "nextjs",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Moiz101-ch/nice-electrolyte-clinical-decision-support/issues"
  },
  "homepage": "https://github.com/Moiz101-ch/nice-electrolyte-clinical-decision-support#readme",
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.30.0",
    "next": "^16.3.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.135.0"
  }
}
