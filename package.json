{
  "name": "nice-electrolyte-clinical-decision-support",
  "version": "0.1.0",
  "private": true,
  "description": "Clinical decision support system for adult electrolyte abnormalities using deterministic NICE based management rules, structured clinical assessment, browser based AI extraction, and evidence retrieval.",
  "type": "module",
  "scripts": {
    "dev": "cross-env NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "cross-env NEXT_TELEMETRY_DISABLED=1 next start",
    "cf:build": "cross-env NEXT_TELEMETRY_DISABLED=1 opennextjs-cloudflare build",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "preview": "npm run cf:build && opennextjs-cloudflare preview",
    "deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "upload": "npm run cf:build && opennextjs-cloudflare upload",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "data:build": "node --experimental-strip-types scripts/build-runtime-data.ts",
    "data:check": "node --experimental-strip-types scripts/build-runtime-data.ts --check && node --experimental-strip-types scripts/sync-synthetic-case-expectations.ts --check",
    "data:sync-cases": "node --experimental-strip-types scripts/sync-synthetic-case-expectations.ts",
    "extraction:demo": "node --experimental-strip-types scripts/show-extraction-examples.ts",
    "hyperkalaemia:demo": "node --experimental-strip-types scripts/show-hyperkalaemia-results.ts",
    "remaining-rules:demo": "node --experimental-strip-types scripts/show-remaining-rule-results.ts",
    "rule-engine:demo": "node --experimental-strip-types scripts/show-rule-engine-example.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "npm run build",
    "test:e2e": "node scripts/run-e2e.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moiz101-ch/nice-electrolyte-clinical-decision-support.git"
  },
  "keywords": [
    "clinical-decision-support",
    "nice",
    "electrolytes",
    "nextjs",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Moiz101-ch/nice-electrolyte-clinical-decision-support/issues"
  },
  "homepage": "https://github.com/Moiz101-ch/nice-electrolyte-clinical-decision-support#readme",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.30.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.13.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
